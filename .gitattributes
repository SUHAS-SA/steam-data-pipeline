# Normalize all text files
* text=auto

# Keep source code LF
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Git LFS (Large File Storage) tracking for Steam Dataset
app_rawdata/*.jsonl filter=lfs diff=lfs merge=lfs -text
app_rawdata/*.jsonl.gz filter=lfs diff=lfs merge=lfs -text
new_sql_files/*.sql filter=lfs diff=lfs merge=lfs -text
steam_apps.json filter=lfs diff=lfs merge=lfs -text